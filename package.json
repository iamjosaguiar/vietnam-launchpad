{
  "name": "vietnam-launchpad",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "postbuild": "node scripts/check-titles.mjs",
    "check:titles": "node scripts/check-titles.mjs",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "lint": "eslint .",
    "check": "npm run lint && npm run build",
    "test:indexnow": "node --test scripts/indexnow.test.mjs",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.9",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^7.4.13",
    "autoprefixer": "^10.4.21",
    "framer-motion": "^12.38.0",
    "libphonenumber-js": "^1.13.17",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "3.4.18",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
