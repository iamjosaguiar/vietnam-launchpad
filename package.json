{
  "name": "vietnam-launchpad",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-titles.mjs",
    "check:titles": "node scripts/check-titles.mjs",
    "start": "next start",
    "lint": "eslint .",
    "export": "next build && next export",
    "deploy": "npm run build",
    "check": "npm run lint && npm run build",
    "test:indexnow": "node --test scripts/indexnow.test.mjs",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vinext/cloudflare": "^1.4.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.1",
    "framer-motion": "^12.38.0",
    "next": "^16.0.1",
    "next-intl": "^4.4.0",
    "postcss": "^8.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  },
  "type": "module"
}
