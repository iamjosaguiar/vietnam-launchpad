{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vietnam-launchpad",
  "account_id": "72708dd4d8bf0cfc8a3f9892ac63cc49",
  "workers_dev": true,
  "compatibility_date": "2026-11-26",
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
